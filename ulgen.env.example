# ulgen's settings: infrapi/lib's INFRAPI_APP_*, and ulgen's INFRAPI_ULGEN_*.
# Read from the file INFRAPI_CONFIG_DOTENV_FILE names (.env when unset).

INFRAPI_APP_NAME="ulgen"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_FQDN="ulgen.example.com"
# where MCP clients reach ulgen, through the gateway: the resource their
# tokens are for, and what a 401 names
INFRAPI_APP_URL="https://api.example.com"
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.1:9700"
INFRAPI_APP_LOG_LEVEL="info"
INFRAPI_APP_LOG_FORMAT="json"

# ulgen's own API group: its endpoints under /apis/mcp.infrapi.io/v1,
# the MCP endpoint /apis/mcp.infrapi.io/v1/-/mcp
INFRAPI_ULGEN_API="mcp.infrapi.io"
# Kayra: the callers, the platform's APIs, the callers' namespaces
INFRAPI_ULGEN_AUTH_URL="https://api.example.com"
# INFRAPI_ULGEN_AUTH_CACHE_TTL="1m"
# where the APIs are reached: INFRAPI_ULGEN_AUTH_URL when unset
# INFRAPI_ULGEN_GATEWAY_URL="https://api.example.com"
# the APIs served, a regular expression on the whole name: every API when unset
# INFRAPI_ULGEN_APIS_INCLUDE=".*\.infrapi\.io"
# INFRAPI_ULGEN_APIS_EXCLUDE="secret\.infrapi\.io"
# how long the APIs and their tools are kept
# INFRAPI_ULGEN_TOOLS_TTL="5m"
